# eBay API credentials (eBay developer account → Application Keys).
# Real values go in a local .env file — never commit them.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Which eBay environment to call: sandbox (default) or production
EBAY_ENV=

# Comma-separated list of front-end origins allowed by CORS
# (default: http://localhost:5173)
ALLOWED_ORIGINS=

# Port the server listens on (default: 5001)
PORT=
